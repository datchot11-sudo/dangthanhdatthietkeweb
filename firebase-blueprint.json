{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and bookmarks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 100 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "avatar": { "type": "string", "maxLength": 500 },
        "bio": { "type": "string", "maxLength": 500 },
        "joinedAt": { "type": "string", "maxLength": 50 },
        "phone": { "type": "string", "maxLength": 30 },
        "location": { "type": "string", "maxLength": 100 },
        "savedCostumes": { "type": "array" },
        "savedArticles": { "type": "array" },
        "notes": { "type": "array" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Festival": {
      "title": "Festival",
      "description": "Cultural festival and traditional events calendar",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 150 },
        "ethnicGroup": { "type": "string", "maxLength": 80 },
        "location": { "type": "string", "maxLength": 150 },
        "timeOfYear": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "costumeHighlights": { "type": "string", "maxLength": 500 },
        "image": { "type": "string", "maxLength": 500 },
        "tags": { "type": "array" }
      },
      "required": ["id", "name", "ethnicGroup", "location", "timeOfYear"]
    },
    "Spotlight": {
      "title": "Spotlight",
      "description": "Cultural promotional banner and spotlight on homepage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "subtitle": { "type": "string", "maxLength": 300 },
        "badge": { "type": "string", "maxLength": 50 },
        "costumeId": { "type": "string", "maxLength": 100 },
        "imageUrl": { "type": "string", "maxLength": 500 },
        "active": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["id", "title", "subtitle", "imageUrl"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "High resolution close-up crafts and video gallery",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "ethnicGroup": { "type": "string", "maxLength": 80 },
        "category": { "type": "string", "enum": ["hoa_van", "trang_suc", "det_nhuom", "le_hoi"] },
        "mediaType": { "type": "string", "enum": ["image", "video"] },
        "url": { "type": "string", "maxLength": 500 },
        "caption": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "title", "ethnicGroup", "category", "url"]
    },
    "Article": {
      "title": "Article",
      "description": "Research and cultural preservation article",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 20000 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "author": { "type": "string", "maxLength": 100 },
        "authorRole": { "type": "string", "maxLength": 100 },
        "publishedAt": { "type": "string", "maxLength": 50 },
        "readTime": { "type": "string", "maxLength": 50 },
        "tags": { "type": "array" },
        "viewsCount": { "type": "number" },
        "comments": { "type": "array" }
      },
      "required": ["id", "title", "content", "author"]
    },
    "Costume": {
      "title": "Costume",
      "description": "Ethnic traditional costume documentation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "ethnicGroup": { "type": "string", "maxLength": 100 },
        "languageFamily": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "maxLength": 50 },
        "regionName": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 2000 },
        "coverImage": { "type": "string", "maxLength": 500 },
        "badge": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "name", "ethnicGroup", "region"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with saved bookmarks and personal notes"
    },
    "/festivals/{festivalId}": {
      "schema": "Festival",
      "description": "Cultural festivals and events calendar"
    },
    "/spotlights/{spotlightId}": {
      "schema": "Spotlight",
      "description": "Featured banners for homepage cultural spotlight"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "High-res photos and videos of ethnic costume details"
    },
    "/articles/{articleId}": {
      "schema": "Article",
      "description": "Cultural articles and research essays"
    },
    "/costumes/{costumeId}": {
      "schema": "Costume",
      "description": "54 ethnic groups traditional costumes catalog"
    }
  }
}
